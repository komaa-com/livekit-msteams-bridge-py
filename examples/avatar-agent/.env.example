LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

# bitHuman avatar (required by worker.py; prewarm fails fast if either is missing):
BITHUMAN_API_SECRET=
BITHUMAN_MODEL_PATH=./avatar.imx

# --- model stack: pick ONE of the three tiers below ---

# Tier 3 (fallback): plain OpenAI. Used when no AZURE_* values are set.
OPENAI_API_KEY=sk-...

# Tier 1 (preferred where available): Azure speech-to-speech realtime. Needs no separate
# whisper/tts deployments, which an Azure OpenAI resource commonly does not have. The avatar
# lip-syncs whatever audio the session produces, so the tier is orthogonal to the avatar.
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
#AZURE_OPENAI_API_KEY=...
#AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
# Realtime is served from a DIFFERENT host than the chat deployments on the SAME resource:
# <resource>.cognitiveservices.azure.com. <resource>.openai.azure.com 404s the websocket
# handshake. Defaults to AZURE_OPENAI_ENDPOINT, so set this when yours differs.
#AZURE_OPENAI_REALTIME_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# Realtime moves on its own api-version cadence, and the value SELECTS THE ROUTE: with a version
# the SDK dials /openai/realtime?api-version=..&deployment=.., without one /openai/v1/realtime.
#AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview
# Defaults to cedar here, not the SDK's marin: the .imx avatar this example ships is male.
#AZURE_OPENAI_REALTIME_VOICE=cedar

# Tier 2: Azure with separate STT/LLM/TTS deployments. Set the endpoint + key WITHOUT a realtime
# deployment. The defaults below mirror the plain-OpenAI model ids, and are exactly the names that
# return 404 DeploymentNotFound on a chat-only resource - which is what tier 1 exists to avoid.
#AZURE_OPENAI_API_VERSION=2024-10-21
#AZURE_OPENAI_STT_DEPLOYMENT=whisper
#AZURE_OPENAI_MODEL_NAME=gpt-4o-mini
#AZURE_OPENAI_TTS_DEPLOYMENT=tts-1
#AZURE_OPENAI_TTS_VOICE=alloy
